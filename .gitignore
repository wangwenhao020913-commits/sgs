# 本地 markdown issue tracker 的工作产物
.scratch/

# Python 虚拟环境与构建/缓存产物
.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/

# 录像（M4 的一局游玩存档；不入库——它是游玩事实，不是门禁基准）
runs/

# 开源收口（2026-11-13）：下面这些是别人 / 本机的东西，绝不入库。
# 注意 `.gitignore` **不支持行尾注释**——注释一律单独成行。

# 第三方工具的解压目录（自用素材，不是本仓代码）
archify-main/

# 语音素材的原始目录（版权素材的来源，只在 NOTICE 里点名）
SGS_OL_Cardvioces/

# 本机截图 / 背景图（README 不放图片；真要放就显式 `git add -f`）。
# 例外：`pic/portraits/` 是**随仓分发**的武将立绘（115 张；版权与移除口径见 NOTICE 第 2 节）。
# `index.json` 是 `tools/build-portraits.py` 的生成期快照（含本机绝对路径），不入库。
pic/*
!pic/portraits/
pic/portraits/index.json

# Windows 快捷方式 / 代码图谱索引（本机产物）
SGS.lnk
codegraph.json

# 素材包压缩文件，以及 Windows「下载自网络」的 ADS 标记
# 尾缀 `*`：立绘目录里有 `xxx.jpg:Zone.Identifier` 与 `xxx.jpg:Zone.Identifier.lnk` 两种。
*.zip
*:Zone.Identifier*
