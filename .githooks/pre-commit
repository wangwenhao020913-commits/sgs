#!/usr/bin/env bash
# 门禁 hook（M3 retro 落地；W5-03 retro 加 docs 快路径）。
#
# 提交时的门禁入口就在这里（CI 跑的是同一条 run_all.sh，判据不变）：
# `tests/run_all.sh` 再全，没人跑它等于零。默认**不装**——每个 clone 跑一次
# `bash tools/install-hooks.sh` 把它接到 pre-commit 上。
#
# 分级在 `tools/gate-staged.sh`：
# - `src/` / `tests/`          → 全量 `tests/run_all.sh`；
# - `开发文档/` / `GLOSSARY.md` / `AGENTS.md` / `CODING_STANDARDS.md` / `docs/`
#                              → 快速文档检查（含账本 06 §5 的机械校验）；
# - 其它                       → 跳过。
#
# 门禁跑的是**工作树**而不是暂存区，所以提交前确认没有别的半成品改动混在里面。
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"
exec bash "$ROOT/tools/gate-staged.sh" --run "门禁 hook"
